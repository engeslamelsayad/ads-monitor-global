# ===== مطلوب =====
# بوت الأدمن المركزي (من @BotFather) — منه تضيف وتدير العملاء
ADMIN_BOT_TOKEN=
# Chat ID بتاعك (واحد أو أكتر مفصولين بفاصلة)
ADMIN_CHAT_IDS=
# مفتاح Anthropic — مشترك لكل العملاء
ANTHROPIC_API_KEY=
# مفتاح تشفير توكنات العملاء (32+ حرف عشوائي) — لا تغيّره بعد أول تشغيل
ENCRYPTION_KEY=

# ===== TikTok (لربط حسابات العملاء عبر OAuth) =====
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://eecm.co

# ===== اختياري =====
# مسار البيانات (Railway Volume)
DATA_DIR=/app/data
# الموديلات (لو حبيت تغيرها)
AI_MODEL_HEAVY=claude-sonnet-5-5
AI_MODEL_LIGHT=claude-haiku-5-5
